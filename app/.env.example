# Environment variables for the NestJS API and for Prisma.
# Copy this file to .env and fill in your own values.

DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@dbhost:5432/postgres?schema=public"

# Point this at the Firefly III database. The schema must be "matching",
# otherwise the pgvector column does not work. Use "matching." prefixes in raw SQL.
FIREFLY_DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@dbhost:5432/firefly?schema=matching"

FIREFLY_API_URL="https://banking.example.com"
FIREFLY_API_TOKEN="replace-with-your-firefly-iii-personal-access-token"

# Secret used to sign JWT access tokens. Use a long random string.
JWT_SECRET="replace-with-a-long-random-secret"

# Embedding model used by the transaction matching module.
# The embedding model (Xenova/all-MiniLM-L6-v2) is fixed in code, not configurable:
# see src/matching/embedding/embedding.service.ts
